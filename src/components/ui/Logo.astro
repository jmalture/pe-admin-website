---
/**
 * PE Admin logo, vectorised from PE_Admin-06.png (pe-admin.de). The dark parts ("P" and "Admin") use
 * currentColor so the logo works on light and dark backgrounds; the E-bars keep the brand blues.
 * mark = only the P/E symbol.
 */
import { LOGO_DARK, LOGO_MID, LOGO_LIGHT } from './logo-paths';

interface Props {
  mark?: boolean;
  class?: string;
  label?: string;
}
const { mark = false, class: cls, label = 'PE Admin' } = Astro.props;
---

<svg
  class={cls}
  viewBox={mark ? '0 0 400 349' : '0 0 2049 349'}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <path fill="currentColor" fill-rule="evenodd" d={LOGO_DARK}></path>
  <path fill="#1b6ea8" fill-rule="evenodd" d={LOGO_MID}></path>
  <path fill="#49b5f2" fill-rule="evenodd" d={LOGO_LIGHT}></path>
</svg>
