---
/**
 * The closing words of the live site with Franz Swidriw's photo. The photo is cut with the logo's bar corners
 * (rounded top-right + bottom-left) and three logo bars slide in beside it.
 */
import { T } from '../../i18n';
---

<section class="pe-section pe-founder">
  <div class="pe-wrap pe-founder__grid">
    <figure class="pe-founder__photo" data-reveal="fade">
      <div class="pe-founder__frame">
        <img
          src="/media/pe-founder-1600.webp"
          srcset="/media/pe-founder-960.webp 960w, /media/pe-founder-1600.webp 1600w"
          sizes="(max-width: 900px) 100vw, 50vw"
          alt={`${T.founder_name}, ${T.founder_role}, PE Admin GmbH`}
          width="1600"
          height="1066"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="pe-founder__bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </figure>
    <blockquote class="pe-founder__text">
      <p class="pe-founder__big" data-words>
        {
          T.founder_text_1.split(' ').map((w, i, a) => (
            <span class="pe-w" style={`--k:${(i / a.length) * 2}`}>
              {w}{' '}
            </span>
          ))
        }
      </p>
      <p class="pe-lead" data-reveal style="--i:1">{T.founder_text_2}</p>
      <footer data-reveal style="--i:2">
        <strong>{T.founder_name}</strong>
        <span>{T.founder_role}</span>
      </footer>
    </blockquote>
  </div>
</section>

<style is:global>
  .pe-founder__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
  }
  .pe-founder__photo {
    position: relative;
  }
  .pe-founder__frame {
    overflow: hidden;
    border-radius: 0 clamp(60px, 9vw, 140px) 0 clamp(60px, 9vw, 140px);
    background: var(--pe-mist);
  }
  .pe-founder__frame img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 50% 20%;
    transition: scale 1.6s var(--pe-ease);
    scale: 1.08;
  }
  .pe-founder__photo.is-in .pe-founder__frame img,
  .pe-founder__photo:not([data-reveal]) .pe-founder__frame img {
    scale: 1;
  }
  .pe-founder__bars {
    position: absolute;
    right: calc(var(--pe-gutter) * -0.4);
    bottom: -22px;
    display: grid;
    gap: 9px;
    justify-items: end;
  }
  .pe-founder__bars i {
    display: block;
    height: 16px;
    border-radius: 0 16px 0 16px;
    background: var(--pe-blue);
    transform-origin: 100% 50%;
    transition: scale 1.1s var(--pe-ease);
  }
  .pe-founder__bars i:nth-child(1) {
    width: 120px;
  }
  .pe-founder__bars i:nth-child(2) {
    width: 84px;
    background: var(--pe-sky);
    transition-delay: 120ms;
  }
  .pe-founder__bars i:nth-child(3) {
    width: 120px;
    transition-delay: 240ms;
  }
  .js .pe-founder__photo[data-reveal] .pe-founder__bars i {
    scale: 0 1;
  }
  .js .pe-founder__photo[data-reveal].is-in .pe-founder__bars i {
    scale: 1 1;
  }
  .pe-founder__big {
    font-size: clamp(1.5rem, 1.05rem + 1.8vw, 2.5rem);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--pe-navy);
  }
  .pe-founder__text .pe-lead {
    margin-top: 22px;
  }
  .pe-founder__text footer {
    display: grid;
    margin-top: 28px;
    padding-left: 18px;
    border-left: 3px solid var(--pe-sky);
  }
  .pe-founder__text footer strong {
    font-size: 1.125rem;
    color: var(--pe-navy);
  }
  .pe-founder__text footer span {
    color: var(--pe-grey);
  }
  @media (max-width: 900px) {
    .pe-founder__grid {
      grid-template-columns: 1fr;
    }
    .pe-founder__bars {
      right: 0;
    }
  }
</style>
