---
/**
 * Hero: deep navy with the live light particles (src/scripts/particles.ts) instead of the two stock photos.
 * Text 1:1 from pe-admin.de: "PE Admin GmbH" + the claim, split into headline and lead.
 */
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { T } from '../../i18n';
---

<section class="pe-hero" data-hero>
  <canvas class="pe-hero__canvas" aria-hidden="true"></canvas>
  <div class="pe-hero__vignette" aria-hidden="true"></div>
  <div class="pe-wrap pe-hero__content">
    <span class="pe-kicker pe-kicker--light pe-kicker--mark" data-reveal="fade"
      ><Logo mark class="pe-kicker__mark" label="" />{T.hero_kicker}</span
    >
    <h1 class="pe-hero__title pe-lines">
      <span class="pe-line" style="--l:0"><span>{T.hero_l1}</span></span>
      <span class="pe-line" style="--l:1"><span class="pe-hero__glow">{T.hero_l2}</span></span>
    </h1>
    <p class="pe-hero__lead" data-reveal style="--i:4">{T.hero_lead}</p>
    <div class="pe-hero__actions" data-reveal style="--i:5">
      <a class="pe-btn" href="#leistungen">{T.hero_cta}<Icon name="arrow" /></a>
      <a class="pe-btn pe-btn--ghost" href="#kontakt">{T.hero_cta2}</a>
    </div>
  </div>
  <a class="pe-hero__scroll" href="#ueber-uns"><span>{T.hero_scroll}</span><i aria-hidden="true"></i></a>
</section>

<script>
  import { startParticles } from '../../scripts/particles';
  const c = document.querySelector<HTMLCanvasElement>('.pe-hero__canvas');
  if (c) startParticles(c);
</script>

<style is:global>
  .pe-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: max(640px, 100svh);
    overflow: clip;
    color: #fff;
    --fx: 79%;
    --fy: 47%;
    /* deep night base, a cold blue sweep from the top left, a teal undertone at the bottom and the warm light
       around the mark */
    background:
      radial-gradient(40% 50% at var(--fx) var(--fy), rgba(255, 154, 77, 0.16), transparent 65%),
      radial-gradient(55% 45% at 92% 8%, rgba(73, 181, 242, 0.22), transparent 70%),
      radial-gradient(80% 60% at 8% 0%, rgba(27, 110, 168, 0.55), transparent 65%),
      radial-gradient(90% 55% at 30% 105%, rgba(16, 120, 140, 0.28), transparent 70%),
      linear-gradient(168deg, #052b42 0%, #03223a 45%, var(--pe-night) 100%);
  }
  /* faint, slow light rays fanning out from the mark (kept subtle on purpose): two conic layers with uneven spacing turning in opposite
     directions, masked to fade out with distance */
  @property --pe-ray {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }
  .pe-hero::before,
  .pe-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    -webkit-mask: radial-gradient(
      70% 85% at var(--fx) var(--fy),
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.35) 30%,
      transparent 64%
    );
    mask: radial-gradient(
      70% 85% at var(--fx) var(--fy),
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.35) 30%,
      transparent 64%
    );
  }
  .pe-hero::before {
    background: repeating-conic-gradient(
      from var(--pe-ray) at var(--fx) var(--fy),
      transparent 0deg,
      rgba(132, 209, 252, 0.042) 2.5deg,
      transparent 5deg 13deg
    );
    animation: pe-rays 220s linear infinite;
  }
  .pe-hero::after {
    background: repeating-conic-gradient(
      from var(--pe-ray) at var(--fx) var(--fy),
      transparent 0deg 6deg,
      rgba(255, 200, 150, 0.028) 9deg,
      transparent 12deg 21deg
    );
    animation: pe-rays 300s linear infinite reverse;
  }
  @keyframes pe-rays {
    to {
      --pe-ray: 360deg;
    }
  }
  @media (max-width: 899px) {
    .pe-hero {
      --fx: 62%;
      --fy: 30%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pe-hero::before,
    .pe-hero::after {
      animation: none;
    }
  }
  .pe-hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .pe-hero__vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(0deg, rgba(2, 27, 42, 0.7), transparent 30%);
  }
  .pe-hero__content {
    padding-top: calc(var(--pe-header-h) + 32px);
    padding-bottom: 120px;
  }
  .pe-hero__title {
    margin-top: 22px;
    font-size: var(--pe-h1);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  /* the second line carries the warm light of the sparks */
  .pe-hero__glow {
    background: linear-gradient(100deg, #fff 0%, var(--pe-ice) 45%, var(--pe-amber) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .pe-hero__lead {
    max-width: 40ch;
    margin-top: clamp(20px, 2.4vw, 32px);
    font-size: var(--pe-lead);
    color: rgba(255, 255, 255, 0.78);
  }
  .pe-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(28px, 3vw, 40px);
  }
  .pe-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
  }
  .pe-hero__scroll i {
    position: relative;
    width: 1.5px;
    height: 40px;
    background: rgba(255, 255, 255, 0.22);
    overflow: hidden;
  }
  .pe-hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--pe-amber);
    animation: pe-scrollcue 2.2s var(--pe-ease-io) infinite;
  }
  @keyframes pe-scrollcue {
    0% {
      translate: 0 -100%;
    }
    60%,
    100% {
      translate: 0 100%;
    }
  }
  @supports (animation-timeline: view()) {
    .pe-hero__content {
      animation: pe-hero-lift linear both;
      animation-timeline: view();
      animation-range: exit 0% exit 70%;
    }
  }
  @keyframes pe-hero-lift {
    to {
      transform: translateY(-70px);
      opacity: 0;
    }
  }
  @media (max-width: 899px) {
    .pe-hero {
      align-items: end;
    }
    .pe-hero__title {
      font-size: clamp(2.4rem, 1rem + 6.4vw, 3.4rem);
    }
  }
</style>
